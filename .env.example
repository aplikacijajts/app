# JTS Logistics TMS — environment variables (copy to .env or set in Render > Environment).
# Placeholders only. Never commit real secrets.

PORT=4000
NODE_ENV=production            # enables HSTS and Secure cookies

# Storage (Render: point these at the persistent disk, see render.yaml)
DATA_DIR=./data
UPLOAD_DIR=./uploads
DB_FILE=./data/db.json

# Sessions / sign-in protection
SESSION_TTL_MS=43200000        # 12 h
LOGIN_MAX_FAILURES=8           # failed sign-ins per account + address ...
LOGIN_WINDOW_MS=900000         # ... within this window (15 min)

# Upload limits (bytes)
MAX_UPLOAD_BYTES=52428800
MAX_INTAKE_FILE_BYTES=41943040
MAX_CHAT_UPLOAD_BYTES=15728640
MAX_CHAT_UPLOAD_FILES=10
MAX_JSON_BYTES=5242880

# Web Push (generate with: npm run generate:vapid). If unset, keys are generated
# once and stored in DATA_DIR/vapid-keys.json (keep that file private).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dispatch@example.com

# WebRTC voice calls. A TURN server is strongly recommended for drivers on mobile networks.
RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
RTC_TURN_URL=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=
CALL_RING_TIMEOUT_MS=60000

# RTS Financial MC check (optional)
RTS_API_URL=
RTS_API_KEY=
RTS_USERNAME=
RTS_PASSWORD=

# OCR (Docker image installs Poppler + Tesseract)
OCR_LANG=eng
OCR_MAX_PAGES=8
OCR_TIMEOUT_MS=60000

# Location
LOCATION_RETENTION_HOURS=72
